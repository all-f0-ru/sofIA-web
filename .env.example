# Modo de la demo: "simulado" usa datos de ejemplo; "ia" usará el modelo semántico real.
SOFIA_MODO=simulado

# Se usarán cuando la demo se conecte a la IA real (todavía no se leen):
# SOFIA_IA_API_KEY=
# SOFIA_DB_URL=

# --- Chat del sitio (Edge Function /api/sofia) ---
# SOFIA_WEBHOOK_URL=https://TU-DOMINIO-N8N/webhook/sofia-chat
# SOFIA_API_KEY=            (Value de la credencial Header Auth del nodo "Webhook sofIA")
# SOFIA_USERS={"CODIGO-USUARIO":{"userId":"usuario-demo","rol":"usuario"},"CODIGO-ADMIN":{"userId":"admin-demo","rol":"administrador"}}

# --- Carga de archivos (/api/cargar) ---
# CODIGO_ADMIN=
# N8N_CARGA_URL=https://TU-DOMINIO-N8N/webhook/gealytics-cargar-archivo
# N8N_CARGA_HEADER=x-api-key
# N8N_CARGA_KEY=

